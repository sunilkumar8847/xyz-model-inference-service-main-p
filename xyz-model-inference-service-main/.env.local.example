# ================================================================
# Model Inference Service — Local Overrides Example
# .env.local.example  (committed)
#
# Copy to .env.local:
#   cp .env.local.example .env.local
#
# Prerequisites:
#   1. Platform infra running (Redis):
#        cd C:\XYZFusion\platform\docker
#        docker compose -f docker-compose.infra.yml up -d
#
#   2. Feature Store running (optional):
#        cd ..\xyz-feature-store-service && make run-local
#
#   3. Triton + MLflow are optional for local dev.
#      Sub-components are None unless configured.
#
#   4. Install: poetry install
#   5. Run:     make run-local
# ================================================================

ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Redis password — shared platform infra
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# Optional — set if Triton is running locally
# TRITON_HOST=localhost
# TRITON_GRPC_PORT=8001

# Optional — set if MLflow is running locally
# MLFLOW_TRACKING_URI=http://localhost:5000

ENABLE_OPENTELEMETRY=false
AB_TEST_ENABLED=false
