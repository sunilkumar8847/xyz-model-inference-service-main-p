# .env.example
"""Environment variables template."""

# Service Configuration
ENVIRONMENT=development
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=INFO

# Triton Inference Server
TRITON_HOST=localhost
TRITON_PORT=8001
TRITON_GRPC_PORT=8001
TRITON_TIMEOUT_MS=200
TRITON_MAX_RETRIES=3

# Feature Store (Feast)
FEATURE_STORE_URL=http://localhost:8080
FEATURE_STORE_TIMEOUT_S=10
FEATURE_STORE_CACHE_TTL_S=300

# MLflow Model Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_URI=http://localhost:5000
MLFLOW_MODEL_NAME=customer_matcher
MLFLOW_REFRESH_INTERVAL_S=300

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL_S=3600
REDIS_MAX_CONNECTIONS=50

# Model Configuration
DEFAULT_MODEL_VERSION=latest
INFERENCE_TIMEOUT_MS=200
ENABLE_SHAP=true
FALLBACK_ENABLED=true

# A/B Testing
AB_TEST_ENABLED=false
CHAMPION_MODEL_VERSION=v5
CHALLENGER_MODEL_VERSION=
CHALLENGER_TRAFFIC_PCT=10

# Monitoring
ENABLE_PROMETHEUS=true
ENABLE_OPENTELEMETRY=true
