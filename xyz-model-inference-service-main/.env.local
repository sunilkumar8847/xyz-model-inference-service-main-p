# ================================================================
# Model Inference Service — Local Overrides (git-ignored)
# Points at the shared infra stack in ../../infra/docker-compose.yml
# ================================================================

ENVIRONMENT=local
LOG_LEVEL=DEBUG

# Redis — shared infra runs with NO auth; leave blank
REDIS_PASSWORD=

# Disable optional services locally unless running
ENABLE_OPENTELEMETRY=false
AB_TEST_ENABLED=false

# Fully disable OTel SDK exporters (no otel-collector in local demo) — native OTel env var
OTEL_SDK_DISABLED=true
