# ================================================================
# Model Inference Service — Base Configuration
# .env  (committed — no secrets)
#
# Pydantic Settings loads: .env → .env.local (later overrides earlier)
#
# Git-ignored secret files:
#   .env.local       → local secrets / overrides
#   .env.dev         → dev (CI/CD injected)
#   .env.stg         → staging
#   .env.integration → integration
#   .env.prd         → production
#
# NOTE: Triton and MLflow are NOT in shared infra.
#       Sub-components are optional (None) for local dev.
#       Set FEATURE_STORE_URL, TRITON_HOST, MLFLOW_TRACKING_URI
#       only when those services are running.
# ================================================================

# Service
ENVIRONMENT=local
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8090
LOG_LEVEL=INFO

# Triton Inference Server (optional — not in shared infra)
TRITON_HOST=localhost
TRITON_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_TIMEOUT_MS=200
TRITON_MAX_RETRIES=3
TRITON_HEALTH_CHECK_INTERVAL=30

# Feature Store — standardized port
FEATURE_STORE_URL=http://localhost:8115
FEATURE_STORE_TIMEOUT_S=10
FEATURE_STORE_CACHE_TTL_S=300

# MLflow Model Registry (optional — not in shared infra)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_REGISTRY_URI=http://localhost:5000
MLFLOW_MODEL_NAME=customer_matcher
MLFLOW_REFRESH_INTERVAL_S=300

# Redis — shared platform infra
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_S=3600
REDIS_MAX_CONNECTIONS=50

# Model Configuration
DEFAULT_MODEL_VERSION=latest
INFERENCE_TIMEOUT_MS=200
ENABLE_SHAP=true
FALLBACK_ENABLED=true

# A/B Testing
AB_TEST_ENABLED=false
CHAMPION_MODEL_VERSION=v5
CHALLENGER_MODEL_VERSION=
CHALLENGER_TRAFFIC_PCT=10

# Monitoring
ENABLE_PROMETHEUS=true
ENABLE_OPENTELEMETRY=false
