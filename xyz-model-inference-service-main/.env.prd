# ================================================================
# Model Inference Service — Production Overrides
# .env.prd  (git-ignored, injected by secrets manager)
# ================================================================

ENVIRONMENT=production
SERVICE_PORT=8080
LOG_LEVEL=WARNING

REDIS_HOST=${REDIS_HOST}
REDIS_PASSWORD=${REDIS_PASSWORD}
FEATURE_STORE_URL=${FEATURE_STORE_URL}
TRITON_HOST=${TRITON_HOST}
TRITON_GRPC_PORT=${TRITON_GRPC_PORT}
MLFLOW_TRACKING_URI=${MLFLOW_TRACKING_URI}
MLFLOW_REGISTRY_URI=${MLFLOW_REGISTRY_URI}
ENABLE_OPENTELEMETRY=true
AB_TEST_ENABLED=${AB_TEST_ENABLED}
CHAMPION_MODEL_VERSION=${CHAMPION_MODEL_VERSION}
CHALLENGER_MODEL_VERSION=${CHALLENGER_MODEL_VERSION}
CHALLENGER_TRAFFIC_PCT=${CHALLENGER_TRAFFIC_PCT}
